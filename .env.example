# ============================================================================
# Cloudflare Radar Country Disruption Analysis — environment template
# ============================================================================
# 1. Copy this file to ".env" in the same folder:
#       cp .env.example .env          (macOS / Linux)
#       Copy-Item .env.example .env   (Windows PowerShell)
# 2. Fill in YOUR OWN values below (do NOT commit the .env file — it is
#    git-ignored).
# 3. Both the notebook and monitor.py will pick the values up automatically.
# ----------------------------------------------------------------------------

# REQUIRED — Cloudflare API token with the "Radar Read" permission.
# Create one at:  https://dash.cloudflare.com/profile/api-tokens
# (Use a token, not your global API key.)
CLOUDFLARE_API_TOKEN=

# OPTIONAL — ISO alpha-2 country code (US, BR, IR, KE, IN, RU, EG, ...).
# If left blank, the notebook prompts you on the first cell run.
# monitor.py ignores this and uses its required --location CLI flag.
CFR_LOCATION=

# OPTIONAL — Look-back window understood by Cloudflare Radar.
# Examples: 7d, 14d, 28d, 90d, 52w.  Default if blank: 28d.
CFR_DATE_RANGE=

# OPTIONAL — Aggregation interval for the time series.
# Examples: 15m, 1h, 1d.  Default if blank: 1h.
CFR_AGG_INTERVAL=
